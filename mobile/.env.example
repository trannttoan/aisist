# Google OAuth Client ID (iOS)
# Get this from Google Cloud Console > APIs & Services > Credentials
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Aisist API base URL: the auth proxy (public funnel URL), or the
# desktop's tailnet URL for on-tailnet development.
EXPO_PUBLIC_LANGGRAPH_API_URL=

# Optional when the deployed assistant ID differs from the graph name.
# Defaults to "agent".
EXPO_PUBLIC_LANGGRAPH_ASSISTANT_ID=agent
