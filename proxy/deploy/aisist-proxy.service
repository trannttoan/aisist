[Unit]
Description=aisist auth proxy
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/aisist/proxy
# LANGGRAPH_UPSTREAM_URL and PORT live on the box, not in git
EnvironmentFile=/etc/aisist-proxy.env
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
